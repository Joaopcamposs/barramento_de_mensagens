# ── Banco de dados ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=54322
DB_PASSWORD=password
DB_USER=postgres
DB_NAME=postgres

# ── Primeiro cadastro (empresa + usuário admin) ────────────────────
FIRST_COMPANY_ID=<uuid-v4>
FIRST_USER_CPF=<cpf-sem-pontuacao>
FIRST_USER_EMAIL=<email>
FIRST_USER_PASSWORD=<senha-forte>
ADMIN_USER_PREFIX=admin

# ── Segurança / JWT ────────────────────────────────────────────────
AES_KEY=<base64-encoded-32-byte-key>
SECRET_KEY=<jwt-secret-key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60